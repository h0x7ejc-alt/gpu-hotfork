+"""
+
+_DEFAULT_HTML = """
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="UTF-8">
+<title>Mock GPU Server</title>
+<style>
+  body { font-family: monospace; background: #1a1a2e; color: #eee; padding: 2rem; }
+  h1 { color: #7df; }
+  p { color: #aaa; }
+  a { color: #7df; }
+</style>
+</head>
+<body>
+<h1>Mock GPU Server (Default Mode)</h1>
+<p>Open the GPU Hot dashboard at <a href="/">/</a> to view the mock data stream.</p>
+</body>
+</html>
+"""
+
+
+# ---------------------------------------------------------------------------
+# Main entry point
+# ---------------------------------------------------------------------------
+
+def main():
+    parser = argparse.ArgumentParser(description="Mock GPU Hot server")
+    parser.add_argument("--mode", choices=["default", "hub"], default="default",
+                        help="Server mode")
+    parser.add_argument("--nodes", default="node1,node2",
+                        help="Comma-separated node names (hub mode)")
+    parser.add_argument("--gpus", type=int, default=4,
+                        help="GPUs per node")
+    parser.add_argument("--simulate-offline", default="",
+                        help="Comma-separated node names that start offline (hub mode)")
+    parser.add_argument("--port", type=int, default=1312,
+                        help="Port to listen on")
+    parser.add_argument("--host", default="0.0.0.0",
+                        help="Host to bind")
+    args = parser.parse_args()
+
+    app = FastAPI(title="Mock GPU Hot Server")
+
+    @app.get("/")
+    async def index():
+        if args.mode == "hub":
+            return HTMLResponse(content=_HUB_CONTROL_HTML)
+        return HTMLResponse(content=_DEFAULT_HTML)
+
+    if args.mode == "default":
+        register_default_handlers(app, args.gpus)
+        logger.info(f"Starting mock server in DEFAULT mode with {args.gpus} GPU(s)")
+        logger.info(f"Dashboard: http://{args.host}:{args.port}/")
+    else:
+        node_list = [n.strip() for n in args.nodes.split(",") if n.strip()]
+        offline_list = [n.strip() for n in args.simulate_offline.split(",") if n.strip()]
+        hub = MockHub(node_list, args.gpus, offline_list)
+        register_hub_handlers(app, hub)
+        logger.info(f"Starting mock server in HUB mode with {len(node_list)} node(s) x {args.gpus} GPU(s)")
+        logger.info(f"Nodes: {node_list}")
+        logger.info(f"Initially offline: {offline_list}")
+        logger.info(f"Control panel: http://{args.host}:{args.port}/")
+
+    uvicorn.run(app, host=args.host, port=args.port, log_level="info")
+
+
+if __name__ == "__main__":
+    main()
