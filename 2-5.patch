+  code { color: #dfd; }
+</style>
+</head>
+<body>
+<h1>Mock GPU Hub Control Panel</h1>
+<p>Connect your browser to the same host/port to see the dashboard.</p>
+
+<div class="controls">
+  <b>Node controls:</b><br>
+  <div id="buttons"></div>
+</div>
+
+<div class="info">
+  <b>Send raw command:</b><br>
+  <input id="cmd" style="width:300px" placeholder="e.g. toggle_node or set_offline:node1" />
+  <button onclick="sendCmd()">Send</button>
+  <pre id="out">ready</pre>
+</div>
+
+<script>
+const host = location.host;
+let ws;
+function connect() {
+  ws = new WebSocket(`ws://${host}/socket.io/`);
+  ws.onopen = () => { document.getElementById('out').textContent = 'connected'; };
+  ws.onmessage = e => { document.getElementById('out').textContent = 'received cluster data (' + e.data.length + ' bytes)'; };
+  ws.onclose = () => { document.getElementById('out').textContent = 'disconnected'; setTimeout(connect, 2000); };
+  ws.onerror = e => { document.getElementById('out').textContent = 'error'; };
+}
+connect();
+
+function sendCmd() {
