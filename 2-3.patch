+#!/usr/bin/env python3
+"""GPU Hot Mock Server — local debugging tool that simulates GPU nodes.
+
+No real GPU or NVIDIA driver required.  The frontend dashboard connects to
+this server exactly as it would to a real gpu-hot instance.
+
+Usage (run from the repo root so static/ and templates/ are found)::
+
+    python mock_server.py                  # default mode, 4 GPUs
+    python mock_server.py --mode hub       # hub mode, 3 nodes × 2 GPUs
+    python mock_server.py --mode hub --nodes 5 --gpus 4 --scenario random-offline
+"""
+
+from __future__ import annotations
+
+import argparse
+import asyncio
+import json
+import logging
+import math
+import os
+import random
+import sys
+import time
+from datetime import datetime, timezone
+from pathlib import Path
+
+from fastapi import FastAPI, WebSocket
+from fastapi.responses import HTMLResponse
+from fastapi.staticfiles import StaticFiles
+
+# ── helpers ──────────────────────────────────────────────────────────────
+
+def _fluctuate(base: float, pct: float = 5.0) -> float:
+    """Return *base* perturbed by ±*pct*% (reproducible-ish walk)."""
+    delta = base * (pct / 100.0)
+    return round(base + random.uniform(-delta, delta), 2)
+
+
+def _walk(value: float, step_max: float, floor: float, ceil: float) -> float:
+    """Random-walk *value* within [*floor*, *ceil*]."""
+    value += random.uniform(-step_max, step_max)
+    return round(max(floor, min(ceil, value)), 2)
+
