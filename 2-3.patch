+def _make_static_gpu(preset: dict, gpu_id: str, pci_bus_id: str) -> dict:
+    """Return the static part of a GPU report (never changes)."""
+    return {
+        "index": gpu_id,
+        "name": preset["name"],
+        "uuid": f"GPU-{random.randbytes(8).hex().upper()}",
+        "driver_version": "550.127.05",
+        "vbios_version": "95.02.3C.00.01",
+        "brand": preset["brand"],
+        "architecture": preset["architecture"],
+        "cuda_compute_capability": preset["cuda_compute_capability"],
+        "serial": f"{random.randint(1000000000, 9999999999)}",
+        "compute_mode": "Default",
+        "memory_total": preset["memory_total"],
+        "pcie_gen": preset["pcie_gen"],
+        "pcie_gen_max": preset["pcie_gen_max"],
+        "pcie_width": preset["pcie_width"],
+        "pcie_width_max": preset["pcie_width_max"],
+        "pci_bus_id": pci_bus_id,
+        "performance_state": "P0",
+        "throttle_reasons": "None",
+    }
+
+
+def generate_gpu_snapshot(gpu: dict, tick: float) -> dict:
+    """Return one polling snapshot for a GPU, adding dynamic fields."""
+    mem_total = gpu["memory_total"]
+    base_util = gpu.get("_base_util", 45.0)
+    util = _walk(gpu.get("_util", base_util), 8.0, 0, 100)
+    gpu["_util"] = util
+
+    mem_used = round(mem_total * (util / 100.0) * random.uniform(0.6, 1.4))
+    mem_used = max(128, min(mem_total - 128, mem_used))
+
+    temp = _walk(gpu.get("_temp", 55.0), 3.0, 28, 92)
+    gpu["_temp"] = temp
+
+    power = _walk(gpu.get("_power", 180.0), 15.0, 15, 450)
+    gpu["_power"] = power
+
+    fan = _walk(gpu.get("_fan", 45.0), 5.0, 20, 100)
+    gpu["_fan"] = fan
+
+    clock_gfx = _walk(gpu.get("_clock_gfx", 1800.0), 75.0, 300, 3000)
+    gpu["_clock_gfx"] = clock_gfx
+    clock_sm = _walk(gpu.get("_clock_sm", clock_gfx), 75.0, 300, 3000)
+    gpu["_clock_sm"] = clock_sm
+    clock_mem = _walk(gpu.get("_clock_mem", 10500.0), 500.0, 810, 24000)
+    gpu["_clock_mem"] = clock_mem
+    clock_video = _walk(gpu.get("_clock_video", 1500.0), 50.0, 300, 2100)
+    gpu["_clock_video"] = clock_video
+
+    snapshot = {
+        **gpu,
+        "timestamp": datetime.now(timezone.utc).isoformat(),
+        "utilization": util,
+        "memory_utilization": round((mem_used / mem_total) * 100, 1),
+        "memory_used": mem_used,
+        "memory_free": mem_total - mem_used,
+        "temperature": temp,
+        "temperature_memory": round(temp * random.uniform(0.85, 1.05), 0),
+        "power_draw": power,
+        "power_limit": round(power * 1.4, 0),
+        "fan_speed": fan,
+        "fan_speeds": [fan, round(fan * random.uniform(0.9, 1.1), 0)],
+        "clock_graphics": clock_gfx,
+        "clock_sm": clock_sm,
+        "clock_memory": clock_mem,
+        "clock_video": clock_video,
+        "clock_graphics_max": 3000,
+        "clock_sm_max": 3000,
+        "clock_memory_max": 24000,
+        "clock_video_max": 2100,
+        "encoder_utilization": round(util * random.uniform(0, 0.3), 1),
+        "encoder_sessions": max(0, int(util / 30)),
+        "pcie_tx_throughput": round(util * 12.5, 0),
+        "pcie_rx_throughput": round(util * 18.0, 0),
+    }
+
+    # make every snapshot a flat dict so the frontend sees everything
+    return {k: v for k, v in snapshot.items() if not k.startswith("_")}
+
+
+def generate_processes(gpus_snapshot: dict[str, dict]) -> list[dict]:
+    """Return a synthetic process list matching real fields."""
+    procs: list[dict] = []
+    proc_templates = [
+        ("python3.11", 34521), ("python3.11", 34522), ("python3.11", 34523),
+        ("pt_data_worker", 40100), ("torchrun", 40200),
+        ("ollama_runner", 50010), ("vllm.worker", 51010),
+    ]
+    for gpu_id, snap in gpus_snapshot.items():
+        if snap.get("utilization", 0) < 5:
+            continue
+        count = random.randint(1, 3)
+        for _ in range(count):
+            tpl = random.choice(proc_templates)
+            procs.append({
+                "pid": str(tpl[1] + int(gpu_id) * 100 + random.randint(0, 50)),
+                "name": tpl[0],
+                "gpu_uuid": snap.get("uuid", ""),
+                "gpu_id": gpu_id,
+                "memory": round(snap.get("memory_used", 0) / (count + 1) * random.uniform(0.5, 1.2), 0),
+            })
+    return procs
+
+
+def generate_system_info() -> dict:
+    """Synthetic OS-level metrics (psutil shape)."""
+    cpu = _walk(30.0, 8.0, 1, 100)
+    mem_pct = _walk(45.0, 3.0, 10, 98)
+    return {
+        "cpu_percent": cpu,
+        "memory_percent": mem_pct,
+        "memory_total_gb": 256.0,
+        "memory_used_gb": round(256.0 * mem_pct / 100.0, 1),
+        "memory_available_gb": round(256.0 * (100 - mem_pct) / 100.0, 1),
+        "cpu_count": 64,
+        "timestamp": datetime.now(timezone.utc).isoformat(),
+        "swap_percent": round(mem_pct * 0.3, 1),
+        "cpu_freq_current": 3200,
+        "cpu_freq_max": 3800,
+        "load_avg_1": round(cpu / 100.0 * 8, 2),
+        "load_avg_5": round(cpu / 100.0 * 6, 2),
+        "load_avg_15": round(cpu / 100.0 * 5, 2),
+        "net_bytes_sent": random.randint(10**9, 10**11),
+        "net_bytes_recv": random.randint(10**9, 10**11),
+        "disk_read_bytes": random.randint(10**10, 10**12),
+        "disk_write_bytes": random.randint(10**10, 10**12),
+    }
+
