+# ── default-mode WebSocket loop ──────────────────────────────────────────
+
+class MockDefaultNode:
+    """Simulate a single gpu-hot node with N GPUs."""
+
+    def __init__(self, node_name: str, gpu_count: int):
+        self.node_name = node_name
+        self.gpu_count = gpu_count
+        self.connections: set[WebSocket] = set()
+        self.running = False
+
+        rng = random.Random(42)
+        presets = rng.sample(GPU_PRESETS, min(gpu_count, len(GPU_PRESETS)))
+        if gpu_count > len(presets):
+            presets += rng.choices(GPU_PRESETS, k=gpu_count - len(presets))
+
+        self._gpus: dict[str, dict] = {}
+        for i in range(gpu_count):
+            gid = str(i)
+            gpu = dict(presets[i % len(presets)])
+            gpu.update(_make_static_gpu(presets[i % len(presets)], gid, f"00000000:{i+1:02X}:00.0"))
+            self._gpus[gid] = gpu
+
+    async def broadcast_loop(self):
+        while self.running:
+            try:
+                tick = time.monotonic()
+                snapshots = {gid: generate_gpu_snapshot(g, tick) for gid, g in self._gpus.items()}
+                procs = generate_processes(snapshots)
+                sysinfo = generate_system_info()
+
+                payload = {
+                    "mode": "default",
+                    "node_name": self.node_name,
+                    "gpus": snapshots,
+                    "processes": procs,
+                    "system": sysinfo,
+                }
+                text = json.dumps(payload, default=str)
+
+                disc: set[WebSocket] = set()
+                for ws in list(self.connections):
+                    try:
+                        await ws.send_text(text)
+                    except Exception:
+                        disc.add(ws)
+                self.connections -= disc
+            except Exception:
+                logging.getLogger("mock").exception("broadcast error")
+            await asyncio.sleep(0.5)
+
+    async def handle_ws(self, websocket: WebSocket):
+        await websocket.accept()
+        self.connections.add(websocket)
+        if not self.running:
+            self.running = True
+            asyncio.create_task(self.broadcast_loop())
+        try:
+            while True:
+                await websocket.receive_text()
+        except Exception:
+            pass
+        finally:
+            self.connections.discard(websocket)
+
+
+# ── hub-mode internals ───────────────────────────────────────────────────
+
+class MockHubNodeHandle:
+    """Track one simulated node: its GPUs, status, and last data."""
+
+    def __init__(self, node_name: str, gpu_count: int):
+        self.node_name = node_name
+        self.status: str = "online"
+        self.last_update: str | None = None
+
+        rng = random.Random(hash(node_name) & 0xFFFFFFFF)
+        presets = rng.sample(GPU_PRESETS, min(gpu_count, len(GPU_PRESETS)))
+        if gpu_count > len(presets):
+            presets += rng.choices(GPU_PRESETS, k=gpu_count - len(presets))
+
+        self._gpus: dict[str, dict] = {}
+        for i in range(gpu_count):
+            gid = str(i)
+            gpu = dict(presets[i % len(presets)])
+            gpu.update(_make_static_gpu(presets[i % len(presets)], gid, f"00000000:{i+1:02X}:00.0"))
+            self._gpus[gid] = gpu
+
+    def snapshot(self) -> dict:
+        tick = time.monotonic()
+        snapshots = {gid: generate_gpu_snapshot(g, tick) for gid, g in self._gpus.items()}
+        self.last_update = datetime.now(timezone.utc).isoformat()
+        return {
+            "status": self.status,
+            "gpus": snapshots,
+            "processes": generate_processes(snapshots) if self.status == "online" else [],
+            "system": generate_system_info() if self.status == "online" else {},
+            "last_update": self.last_update if self.status == "online" else None,
+        }
+
+    def set_online(self):
+        self.status = "online"
+        self.last_update = datetime.now(timezone.utc).isoformat()
+
+    def set_offline(self):
+        self.status = "offline"
+
+
+class MockHub:
+    """Aggregate multiple simulated nodes and emit hub-mode JSON."""
+
+    def __init__(self, node_names: list[str], gpus_per_node: int, scenario: str):
+        self.nodes: dict[str, MockHubNodeHandle] = {
+            name: MockHubNodeHandle(name, gpus_per_node) for name in node_names
+        }
+        self.scenario = scenario
+        self.connections: set[WebSocket] = set()
+        self.running = False
+
+    async def _scenario_runner(self):
+        if self.scenario == "none":
+            return
+        if self.scenario not in ("random-offline", "rolling-offline", "mixed"):
+            return
+
+        while self.running:
+            await asyncio.sleep(random.uniform(8, 20))
+
+            online = [n for n in self.nodes.values() if n.status == "online"]
+            offline = [n for n in self.nodes.values() if n.status == "offline"]
+
+            if self.scenario == "random-offline":
+                if online and (not offline or random.random() < 0.6):
+                    node = random.choice(online)
+                    node.set_offline()
+                    logging.getLogger("mock").info("[-] %s → offline", node.node_name)
+                if offline and random.random() < 0.5:
+                    node = random.choice(offline)
+                    node.set_online()
+                    logging.getLogger("mock").info("[+] %s → online", node.node_name)
+
+            elif self.scenario == "rolling-offline":
+                # cycle through nodes one at a time
+                if offline:
+                    for n in list(offline):
+                        n.set_online()
+                        logging.getLogger("mock").info("[+] %s → online", n.node_name)
+                elif online:
+                    node = online[0]
+                    node.set_offline()
+                    logging.getLogger("mock").info("[-] %s → offline", node.node_name)
+
+            elif self.scenario == "mixed":
+                # keep at least one online, toggle others randomly
+                if random.random() < 0.5 and len(online) > 1:
+                    node = random.choice(online)
+                    node.set_offline()
+                    logging.getLogger("mock").info("[-] %s → offline", node.node_name)
+                if offline and random.random() < 0.6:
+                    node = random.choice(offline)
+                    node.set_online()
+                    logging.getLogger("mock").info("[+] %s → online", node.node_name)
+
+    async def broadcast_loop(self):
+        while self.running:
+            try:
+                nodes_data = {name: n.snapshot() for name, n in self.nodes.items()}
+                online_count = sum(1 for nd in nodes_data.values() if nd["status"] == "online")
+                total_gpus = sum(len(nd["gpus"]) for nd in nodes_data.values() if nd["status"] == "online")
+
+                payload = {
+                    "mode": "hub",
+                    "nodes": nodes_data,
+                    "cluster_stats": {
+                        "total_nodes": len(self.nodes),
+                        "online_nodes": online_count,
+                        "total_gpus": total_gpus,
+                    },
+                }
+                text = json.dumps(payload, default=str)
+
+                disc: set[WebSocket] = set()
+                for ws in list(self.connections):
+                    try:
+                        await ws.send_text(text)
+                    except Exception:
+                        disc.add(ws)
+                self.connections -= disc
+            except Exception:
+                logging.getLogger("mock").exception("hub broadcast error")
+            await asyncio.sleep(0.5)
+
+    async def handle_ws(self, websocket: WebSocket):
+        await websocket.accept()
+        self.connections.add(websocket)
+        if not self.running:
+            self.running = True
+            asyncio.create_task(self.broadcast_loop())
+            asyncio.create_task(self._scenario_runner())
+        try:
+            while True:
+                await websocket.receive_text()
+        except Exception:
+            pass
+        finally:
+            self.connections.discard(websocket)
+
+
+# ── FastAPI app ──────────────────────────────────────────────────────────
+
+def build_app(args: argparse.Namespace) -> FastAPI:
+    ROOT = Path(__file__).resolve().parent
+
+    app = FastAPI(title="GPU Hot Mock", version="0.0.0")
+
+    if args.mode == "hub":
+        node_names = [f"node-{i+1:02d}" for i in range(args.nodes)]
+        hub = MockHub(node_names, args.gpus, args.scenario)
+
+        @app.websocket("/socket.io/")
+        async def ws_hub(websocket: WebSocket):
+            await hub.handle_ws(websocket)
+
+    else:
+        node = MockDefaultNode(f"mock-{args.gpus}gpu", args.gpus)
+
+        @app.websocket("/socket.io/")
+        async def ws_default(websocket: WebSocket):
+            await node.handle_ws(websocket)
+
+    # static files
+    static_dir = ROOT / "static"
+    if static_dir.is_dir():
+        app.mount("/static", StaticFiles(directory=str(static_dir)), name="static")
+
+    @app.get("/")
+    async def index():
+        tmpl = ROOT / "templates" / "index.html"
+        if tmpl.is_file():
+            return HTMLResponse(content=tmpl.read_text())
+        return HTMLResponse(content="<h1>index.html not found</h1>", status_code=404)
+
+    return app
+
+
+# ── CLI ──────────────────────────────────────────────────────────────────
+
+def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
+    p = argparse.ArgumentParser(
+        description="GPU Hot Mock Server — local debug tool (no GPU needed)",
+        formatter_class=argparse.RawDescriptionHelpFormatter,
+        epilog="""\
+examples:
+  python mock_server.py                             # default mode, 4 GPUs
+  python mock_server.py --mode hub                  # hub mode, 3 nodes × 2 GPUs
+  python mock_server.py --mode hub --scenario random-offline  # node up/down sim
+  python mock_server.py --mode hub --nodes 5 --gpus 4 --port 8080
+        """,
+    )
+    p.add_argument("--mode", choices=["default", "hub"], default="default",
+                   help="Operation mode (default: %(default)s)")
+    p.add_argument("--nodes", type=int, default=3,
+                   help="Number of simulated nodes in hub mode (default: %(default)s)")
+    p.add_argument("--gpus", type=int, default=4,
+                   help="GPUs per node (default: %(default)s)")
+    p.add_argument("--port", type=int, default=1313,
+                   help="HTTP port (default: %(default)s)")
+    p.add_argument("--host", default="0.0.0.0",
+                   help="Bind address (default: %(default)s)")
+    p.add_argument("--scenario",
+                   choices=["none", "random-offline", "rolling-offline", "mixed"],
+                   default="none",
+                   help="Node lifecycle scenario for hub mode (default: %(default)s)")
+    return p.parse_args(argv)
+
+
+def main():
+    args = parse_args()
+    logging.basicConfig(
+        level=logging.INFO,
+        format="%(asctime)s [mock] %(levelname)s %(message)s",
+    )
+    log = logging.getLogger("mock")
+
+    if args.mode == "hub":
+        log.info("mode=hub  nodes=%d  gpus_per_node=%d  scenario=%s",
+                 args.nodes, args.gpus, args.scenario)
+    else:
+        log.info("mode=default  gpus=%d", args.gpus)
+
+    app = build_app(args)
+
+    import uvicorn
+    log.info("listening on http://%s:%d", args.host, args.port)
+    uvicorn.run(app, host=args.host, port=args.port, log_level="info")
+
+
+if __name__ == "__main__":
+    main()
